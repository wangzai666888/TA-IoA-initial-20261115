# Only --planner llm / UI "real model API" uses these settings.
CO_IOA_API_BASE=https://your-provider.example/v1
CO_IOA_MODEL=your-model-name
CO_IOA_API_KEY=
CO_IOA_ALLOW_UNAUTHENTICATED=false
CO_IOA_MODEL_TIMEOUT=120
# Retry temporary timeouts/429/5xx; increase read timeout after a timeout.
CO_IOA_MODEL_MAX_TIMEOUT=240
CO_IOA_MODEL_RETRIES=2
CO_IOA_MODEL_RETRY_BACKOFF=1
CO_IOA_TEMPERATURE=0
# Optional administrative key for POST /api/runs; enter the same key in the UI.
CO_IOA_CONTROL_KEY=
